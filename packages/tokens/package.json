{
  "name": "@sahari-ui/tokens",
  "version": "0.1.1",
  "description": "Framework-agnostic Sahari design tokens as CSS custom properties.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahabatharianmu/sahari-ui.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "dist/*.css"
  ],
  "exports": {
    ".": "./dist/index.css",
    "./index.css": "./dist/index.css",
    "./colors.css": "./dist/colors.css",
    "./typography.css": "./dist/typography.css",
    "./spacing.css": "./dist/spacing.css",
    "./elevation.css": "./dist/elevation.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp src/*.css dist/",
    "typecheck": "true"
  }
}
